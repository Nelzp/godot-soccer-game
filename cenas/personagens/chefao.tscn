[sub_resource type="Shader" id="Shader_flash"]
code = "shader_type canvas_item;

// Clareia o sprite por um instante quando o chefão é atingido.
uniform float intensidade_flash : hint_range(0.0, 1.0) = 0.0;
uniform vec4 cor_flash : source_color = vec4(1.0, 1.0, 1.0, 1.0);

void fragment() {
	COLOR.rgb = mix(COLOR.rgb, cor_flash.rgb, intensidade_flash);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_flash"]
